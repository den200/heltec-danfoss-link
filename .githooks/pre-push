#!/bin/bash
# Refuse to push history that must stay private. Set the blocked root commit
# once per clone (local config, never committed):
#   git config danfoss.blockRoot <commit>
# Any pushed commit that descends from it is refused, on every remote except the
# one named in danfoss.allowRemote (if set).
block=$(git config --get danfoss.blockRoot) || exit 0
[ "$1" = "$(git config --get danfoss.allowRemote)" ] && exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue
  if git merge-base --is-ancestor "$block" "$local_sha" 2>/dev/null; then
    echo "pre-push: $local_ref contains private history (danfoss.blockRoot); not pushing to $1" >&2
    exit 1
  fi
done
exit 0
